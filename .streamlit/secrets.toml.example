# ══════════════════════════════════════════════════════════════════
# Streamlit secrets — cluster-payout-optimization (Cluster Optimizer)
# ══════════════════════════════════════════════════════════════════
# Copy this file to `.streamlit/secrets.toml` on the SERVER only and
# fill in real values. `.streamlit/secrets.toml` is already gitignored —
# it must never be committed. Same mechanism used on Streamlit Cloud;
# self-hosting does not change it.
#
# Note: GROQ_API_KEY for GANDALF AI is read from an environment variable,
# not from here — set it in `.env` instead (see .env.example).

# ── App login (username/email -> password) ──
[users]
"admin@shadowfax.in" = "shadowfax2026"
"admin"              = "shadowfax2026"
"demo@shadowfax.in"  = "demo2026"
"demo"               = "demo2026"

# ── Google BigQuery — pick ONE of the sections below ──

# Option A: personal Gmail OAuth token (expires every ~2 days under this
# workspace's session-control policy — see REFRESH_BQ_TOKEN.bat one level
# up from this repo). Generated by generate_bq_token.py.
[google_oauth]
refresh_token = "1//..."
client_id     = "764086051850-6qr4p6gpi6hn506pt8ejuq83di341hur.apps.googleusercontent.com"
client_secret = "d-FL95Q19q7MQmFpd7hHD0Ty"
token_uri     = "https://oauth2.googleapis.com/token"

# Option B: service account key (does NOT expire — recommended for a
# server that must fetch data unattended, and required for the daily
# 5 AM GitHub Actions refresh's BQ_SERVICE_ACCOUNT_JSON repo secret too).
# Ask the BI/GCP team for this; paste the full JSON key as a TOML table
# below, uncomment, and delete [google_oauth] above.
# [gcp_credentials]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"

# ── Encrypted remote token store (keeps the Gmail refresh token fresh
# automatically across both apps — see REFRESH_BQ_TOKEN.bat) ──
# GH_TOKEN = "github_pat_..."
# TOKEN_DECRYPT_KEY = "..."
